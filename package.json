{
  "name": "pi-web-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pi-web/server dev",
    "dev:web": "pnpm --filter @pi-web/web dev",
    "build": "pnpm --filter @pi-web/web build",
    "start": "NODE_ENV=production pnpm --filter @pi-web/server start",
    "typecheck": "tsc",
    "test": "node --test \"apps/*/src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.14.0"
}
