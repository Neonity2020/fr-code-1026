{
  "name": "pi-web-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-patch.js",
    "dev": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "NODE_ENV=production bun run --cwd apps/server start",
    "typecheck": "tsc",
    "test": "bun test apps packages",
    "test:node": "node --test \"apps/*/src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
